# 统一换行符，避免 Windows / macOS / Linux 贡献者之间产生无意义的整文件差异
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.apk binary
*.keystore binary
*.ttf binary
*.otf binary

# 补丁文件必须保持 LF，否则 pnpm patch 会校验失败
*.patch text eol=lf
*.diff text eol=lf

# 锁定文件视为生成产物，避免在 diff 中展示
pnpm-lock.yaml linguist-generated=true
