# ============================================================
# Glimmer Healing（微光心愈）环境变量示例
# ============================================================
# 复制本文件为 .env 后填入你自己的值：
#
#     cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，请勿提交真实凭据。
# ⚠️ 所有 EXPO_PUBLIC_* 变量都会在构建时内联进客户端 bundle，
#    解包 APK 即可读取。因此它们只适合放**公开**信息
#    （如 Supabase anon key，它本身设计为公开，由 RLS 保护）。
#    任何真正的密钥（service_role key、支付私钥、模型 API Key）
#    必须放在服务端 Edge Function 的 Secrets 中，绝不能写进 EXPO_PUBLIC_*。
# ============================================================

# ── Supabase 连接 ────────────────────────────────────────────
# Supabase 项目 URL，例如 https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon（公开）key。设计上允许公开，权限完全由 RLS 策略控制。
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 应用标识
EXPO_PUBLIC_APP_ID=app-your-app-id

# ── 对外联系信息 ──────────────────────────────────────────────
# 展示在「关于」与「隐私政策」页面。请填写你自己的公开联系方式。
EXPO_PUBLIC_CONTACT_EMAIL=support@example.com
EXPO_PUBLIC_CONTACT_WEBSITE=example.com
EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com

# ── 管理员入口（可选）────────────────────────────────────────
# 留空则管理后台入口关闭。
# 注意：这只是隐藏入口的客户端门禁，不是安全边界。详见 SECURITY.md。
EXPO_PUBLIC_ADMIN_PHONE=
EXPO_PUBLIC_ADMIN_PASSWORD=
